{
    "version": 2,
    "name": "tashico-api",
    "builds": [
      {
        "src": "server.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/server.js"
      }
    ],
    "crons": [
      {
        "path": "/api/internal/sync-products",
        "schedule": "*/10 * * * *"
      },
      {
        "path": "/api/internal/process-email-outbox",
        "schedule": "*/5 * * * *"
      }
    ]
  }
