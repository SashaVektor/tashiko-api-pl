# Application
PORT=4200
MONGODB_URL=mongodb://localhost:27017/tashiko-pl
JWT_SECRET=replace-with-a-long-random-secret
PUBLIC_API_URL=https://your-polish-api.example.com
FE_ORIGIN=https://your-polish-shop.example.com

# Product import and scheduled synchronization
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_SECURE=false
PRODUCT_SYNC_MIN_ROWS=50
PRODUCT_SYNC_MAX_FILE_AGE_HOURS=48
PRODUCT_SYNC_MAX_INVALID_ROW_RATIO=0.05
CRON_SECRET=replace-with-a-long-random-secret

# Tpay
TPAY_CLIENT_ID=
TPAY_CLIENT_SECRET=
TPAY_NOTIFICATION_CODE=
TPAY_ENV=production

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Monobank (only required if the Monobank routes are enabled)
MONOBANK_TOKEN=

# Cloudinary product image uploads
CLOUD_NAME=
CLOUD_KEY=
CLOUD_SECRET=

# SMTP email
ADMIN_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_CONNECTION_TIMEOUT_MS=10000
EMAIL_GREETING_TIMEOUT_MS=10000
EMAIL_SOCKET_TIMEOUT_MS=20000
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_MINUTES=5
EMAIL_OUTBOX_BATCH_SIZE=20
